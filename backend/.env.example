# Backend 환경변수 예시
# 사용법: cp .env.example .env.local

# ============================================
# 보안 / 서버 (선택 — 미설정 시 기존 동작 유지)
# ============================================
# DEBUG=False
# DJANGO_SECRET_KEY=change-me-in-production
# ALLOWED_HOSTS=localhost,127.0.0.1,your-server
# CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:5174
# 파괴적 API(전체 삭제 등) 보호 키 — 설정 시에만 강제
# DESTRUCTIVE_API_KEY=

# ============================================
# DB (PostgreSQL)
# ============================================
# DB_NAME=vf_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# ============================================
# 구글 시트 (FC 입고 데이터)
# ============================================
# Google Sheets API Key (Required for 'google_sheets_refresh')
GOOGLE_SHEETS_API_KEY=your_api_key_here

# FC 입고 데이터 구글 시트 CSV URL (File -> Share -> Publish to web -> CSV)
FC_GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?output=csv

# ============================================
# 마스터 데이터 (카테고리 정보)
# ============================================
# 마스터 데이터 구글 시트 CSV URL
MASTER_DATA_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?output=csv

# ============================================
# 출고 데이터 (Outbound Data)
# ============================================
# 출고 데이터 구글 시트 CSV URL
OUTBOUND_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/e/.../pub?output=csv
# ============================================
# AI 설정 (Anthropic 또는 Ollama)
# ============================================
# AI 백엔드 선택 (anthropic 또는 ollama)
AI_BACKEND=ollama

# Anthropic 설정 (AI_BACKEND=anthropic 인 경우 필수)
# OpenRouter (무료 + 빠른 모델만 — 유료/초대형 금지)
# 기본: 소형 free (답변 속도 우선). 허용: openrouter/free 또는 *:free
OPENROUTER_BASE_URL=https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_SITE_URL=http://localhost:5174
OPENROUTER_APP_NAME=VF Delivery AI

# 하위 호환 (동일 정책)
ANTHROPIC_BASE_URL=https://openrouter.ai
ANTHROPIC_AUTH_TOKEN=sk-or-v1-your_key_here
ANTHROPIC_DEFAULT_SONNET_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Ollama 설정 (AI_BACKEND=ollama 인 경우 필수)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=lfm2.5-thinking:latest

# 타임아웃 설정 (ms)
API_TIMEOUT_MS=60000
